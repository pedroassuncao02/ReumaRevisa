{
  "name": "Reuma Revisa",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "postCreateCommand": "npm ci",
  "postStartCommand": "npm run codespaces:start",
  "forwardPorts": [
    3210
  ],
  "portsAttributes": {
    "3210": {
      "label": "Reuma Revisa",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
