# Copie para .env. Nunca publique a chave.
# API opcional; use o modo manual com ChatGPT sem configurar chave.
OPENAI_API_KEY=
# Somente true habilita chamadas que consomem créditos da API.
OPENAI_AUTOMATIC_ENABLED=false
# Modelo com suporte a Structured Outputs; escolha um disponível na sua conta.
OPENAI_MODEL=gpt-4.1-mini
PORT=3210
DATA_DIR=./data
